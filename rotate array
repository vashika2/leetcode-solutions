class Solution {
    public void rotate(int[] nums, int k) {
        int n = nums.length;

        k = k%n; //this is to avoid unnecessary rotation, for example when k=8 and n= 5, then 8%5 is 3 , so only 3 rotations are required.

        reverse(nums,0,n-1); //reverses the whole array
        reverse(nums,0 , k-1); //reverses the initial k part of the array
        reverse(nums,k,n-1); //this reverses perivously reversed part of the array to correct format
    }

    private void reverse(int[] nums, int left , int right){
        while(left<right){
            int temp = nums[left];
            nums[left] = nums[right];
            nums[right] = temp;

            left++;
            right--;
        }
    }
}
