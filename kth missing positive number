class Solution {
    public int findKthPositive(int[] arr, int k) {
        int left = 0;
        int right = arr.length - 1;

        while(left <= right){
            int mid = left + (right - left)/2;

            int missing = arr[mid] - (mid + 1);

            if(missing < k){
                 left = mid + 1;
            }else{
                right = mid - 1;
            }
        }
        return left + k; //left is the number of array elements that are less than equal to the answer, adding k accounts for the missing numbers.
    }
}
