class Solution {
public:
    vector<int> luckyNumbers(vector<vector<int>>& matrix) {
        vector<int> ans;
        int m = matrix.size();
        int n = matrix[0].size();

        for(int i =0; i<m ;i++){
            int minVal = matrix[i][0];
            int col = 0;
      //find minimum element in the row
            for(int j=1;j<n;j++){
                if(matrix[i][j]<minVal){
                    minVal = matrix[i][j];
                    col = j;
                }
            }
            //check if it is the maximum value in its colunm
            bool isLucky = true;
            for(int k=0; k<m;k++){
                if(matrix[k][col] > minVal){
                    isLucky = false;
                    break;
                }
            }
            if(isLucky){
                ans.push_back(minVal);
            }
        }
        return ans;
    }
};
