class Solution {
public:
    vector<vector<int>> spiralMatrixIII(int rows, int cols, int rStart, int cStart) {
        vector<vector<int>> ans;

        int total = rows * cols;

        int r = rStart;
        int c = cStart;

        ans.push_back({r,c});    //adds the coordinates (r,c) to the answer

        int steps = 1;

        while(ans.size() < total){

            //move right

            for(int i=0; i<steps; i++){
                c++;
                if(r>=0 && r<rows && c>=0 && c<cols)
                  ans.push_back({r,c});
            }

            //move down
            for(int i =0;i<steps;i++){
                r++;
                if(r>=0 && r<rows && c>=0 && c<cols)
                  ans.push_back({r,c});
            }
            steps++;   //increases the length of the spiral

            //move left 
            for(int i=0;i<steps;i++){
                c--;     //c-- because the index of the column decreses when it moves to the left 
                if(r>=0 && r<rows && c>=0 && c<cols)
                  ans.push_back({r,c});
            }

            //move up 
            for(int i=0; i<steps;i++){
                r--;          // r-- because the index of the row decreses when you go upwards
                if(r>=0 && r<rows && c>=0 && c<cols)
                  ans.push_back({r,c});
            }

            steps++;
        }

        return ans;
    }
};
