class Solution {
    public int[] productExceptSelf(int[] nums) {
        // we have to do left and right product here

        int n = nums.length;
        int[] answer = new int[n];

        //product of left
        answer[0] = 1;
        for(int i=1;i<n;i++){
            answer[i] = answer[i - 1] * nums[i-1];
        }

        //product of right
        int right = 1;
        for(int i=n-1 ; i>=0;i--){
            answer[i] *= right;
            right *= nums[i];
        }
        return answer;

    }
}
