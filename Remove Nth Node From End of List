class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {

        int length = 0;
        ListNode temp = head;

        // count length
        while (temp != null) {
            length++;
            temp = temp.next;
        }

        // remove (length - n)th node
        int index = length - n;

        if (index == 0) return head.next;

        temp = head;
        for (int i = 1; i < index; i++) {
            temp = temp.next;
        }

        temp.next = temp.next.next;

        return head;
    }
}
